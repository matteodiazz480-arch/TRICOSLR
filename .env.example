# ==============================================================================
# CONFIGURACIÓN DE FIREBASE PARA TRICO'S BURGERS & CHICKEN
# ==============================================================================
# 1. Copiá este archivo y renombralo como: .env
# 2. Pegá los valores de tu consola de Firebase (Configuración del proyecto > Tus apps > Web)

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tricos-burgers.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tricos-burgers
VITE_FIREBASE_STORAGE_BUCKET=tricos-burgers.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
